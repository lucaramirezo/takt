# takt environment. Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=3000
# WSL2 quirk: host port 5432 is dropped, so local Postgres is published on 15432 -> container 5432.
DATABASE_URL=postgresql://postgres:dev@localhost:15432/takt

# --- Better Auth ---
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Domain / CORS ---
TAKT_DOMAIN=takt.app
CORS_ALLOWLIST=http://localhost:3000,http://localhost:3001,http://localhost:8081

# --- Email (transactional alerts; provider TBD, e.g. Resend) ---
# RESEND_API_KEY=
# EMAIL_FROM=takt <no-reply@takt.app>

# --- Cloudflare R2 (object storage for site-check-in photos) ---
# Deferred: wire in Phase 1 with the remote-clock photo feature. Leave blank until then.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=takt-private
# R2_PUBLIC_BUCKET=takt-public
