{
  "name": "@takt/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./schema": { "types": "./src/schema/index.ts", "import": "./src/schema/index.ts" },
    "./client": { "types": "./src/client.ts", "import": "./src/client.ts" },
    "./rls": { "types": "./src/rls.ts", "import": "./src/rls.ts" },
    "./env": { "types": "./src/env.ts", "import": "./src/env.ts" }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.5"
  },
  "peerDependencies": { "zod": "^4.4.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.0",
    "zod": "^4.4.0"
  }
}
